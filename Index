// Audio Context Helper untuk Efek Suara Kasir ("Tot Tot") & Voice "Pembelian Berhasil"
    let audioCtx = null;
    function playCartBeep() {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        const now = audioCtx.currentTime;

        // Nada Pertama ("Tot" 1)
        const osc1 = audioCtx.createOscillator();
        const gain1 = audioCtx.createGain();
        osc1.type = 'sine';
        osc1.frequency.setValueAtTime(1150, now);
        gain1.gain.setValueAtTime(0.2, now);
        gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
        osc1.connect(gain1);
        gain1.connect(audioCtx.destination);
        osc1.start(now);
        osc1.stop(now + 0.06);

        // Nada Kedua ("Tot" 2 - double beep khas scanner barcode kasir)
        const osc2 = audioCtx.createOscillator();
        const gain2 = audioCtx.createGain();
        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(1450, now + 0.08);
        gain2.gain.setValueAtTime(0.22, now + 0.08);
        gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.16);
        osc2.connect(gain2);
        gain2.connect(audioCtx.destination);
        osc2.start(now + 0.08);
        osc2.stop(now + 0.16);
      } catch (e) {
        console.warn('AudioContext playback error:', e);
      }
    }

    // Suara pelafalan nama barang saat dimasukkan ke keranjang kasir
    function playItemNameVoice(itemName) {
      if (!itemName) return;
      try {
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel(); // Hentikan antrean suara sebelumnya agar responsif saat klik cepat
          const utterance = new SpeechSynthesisUtterance(itemName);
          utterance.lang = 'id-ID';
          utterance.rate = 1.05;
          utterance.pitch = 1.02;
          utterance.volume = 1.0;

          const voices = window.speechSynthesis.getVoices();
          const idVoice = voices.find(v => v.lang === 'id-ID' || v.lang === 'id' || v.lang.startsWith('id'));
          if (idVoice) utterance.voice = idVoice;

          // Berikan jeda 130ms agar bunyi tot-tot kasir selesai terlebih dahulu
          setTimeout(() => {
            window.speechSynthesis.speak(utterance);
          }, 130);
        }
      } catch (e) {
        console.warn('SpeechSynthesis item voice error:', e);
      }
    }

    // Fungsi Terbilang Bahasa Indonesia untuk pelafalan total belanja
    function angkaTerbilang(nilai) {
      const bilangan = ['', 'satu', 'dua', 'tiga', 'empat', 'lima', 'enam', 'tujuh', 'delapan', 'sembilan', 'sepuluh', 'sebelas'];
      nilai = Math.floor(Math.abs(Number(nilai) || 0));

      if (nilai === 0) return 'nol';
      if (nilai < 12) return bilangan[nilai];
      if (nilai < 20) return angkaTerbilang(nilai - 10) + ' belas';
      if (nilai < 100) return angkaTerbilang(Math.floor(nilai / 10)) + ' puluh' + (nilai % 10 !== 0 ? ' ' + angkaTerbilang(nilai % 10) : '');
      if (nilai < 200) return 'seratus' + (nilai - 100 !== 0 ? ' ' + angkaTerbilang(nilai - 100) : '');
      if (nilai < 1000) return angkaTerbilang(Math.floor(nilai / 100)) + ' ratus' + (nilai % 100 !== 0 ? ' ' + angkaTerbilang(nilai % 100) : '');
      if (nilai < 2000) return 'seribu' + (nilai - 1000 !== 0 ? ' ' + angkaTerbilang(nilai - 1000) : '');
      if (nilai < 1000000) return angkaTerbilang(Math.floor(nilai / 1000)) + ' ribu' + (nilai % 1000 !== 0 ? ' ' + angkaTerbilang(nilai % 1000) : '');
      if (nilai < 1000000000) return angkaTerbilang(Math.floor(nilai / 1000000)) + ' juta' + (nilai % 1000000 !== 0 ? ' ' + angkaTerbilang(nilai % 1000000) : '');
      if (nilai < 1000000000000) return angkaTerbilang(Math.floor(nilai / 1000000000)) + ' milyar' + (nilai % 1000000000 !== 0 ? ' ' + angkaTerbilang(nilai % 1000000000) : '');
      return nilai.toString();
    }

    // Suara Notifikasi Pembayaran Berhasil (Chime + Suara Bicara "Pembelian Berhasil. Total Pembayaran ... Rupiah")
    function playPaymentSuccessVoice(totalAmount) {
      try {
        // 1. Bunyikan nada jingle sukses (C5 -> E5 -> G5)
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }

        const now = audioCtx.currentTime;
        const notes = [523.25, 659.25, 783.99]; // Nada C5, E5, G5
        notes.forEach((freq, idx) => {
          const osc = audioCtx.createOscillator();
          const gain = audioCtx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now + (idx * 0.08));
          gain.gain.setValueAtTime(0.18, now + (idx * 0.08));
          gain.gain.exponentialRampToValueAtTime(0.001, now + (idx * 0.08) + 0.25);
          osc.connect(gain);
          gain.connect(audioCtx.destination);
          osc.start(now + (idx * 0.08));
          osc.stop(now + (idx * 0.08) + 0.25);
        });
      } catch (e) {
        console.warn('Jingle playback error:', e);
      }

      // 2. Mainkan suara ucapan bahasa Indonesia lengkap dengan nominal belanja
      try {
        if ('speechSynthesis' in window) {
          window.speechSynthesis.cancel(); // Hentikan antrean suara sebelumnya
          
          let kalimat = "Pembelian berhasil.";
          if (totalAmount && Number(totalAmount) > 0) {
            kalimat += " Total pembayaran " + angkaTerbilang(totalAmount) + " rupiah.";
          }

          const utterance = new SpeechSynthesisUtterance(kalimat);
          utterance.lang = 'id-ID';
          utterance.rate = 1.0;
          utterance.pitch = 1.05;
          utterance.volume = 1.0;

          // Pilih suara bahasa Indonesia jika tersedia di sistem
          const voices = window.speechSynthesis.getVoices();
          const idVoice = voices.find(v => v.lang === 'id-ID' || v.lang === 'id' || v.lang.startsWith('id'));
          if (idVoice) {
            utterance.voice = idVoice;
          }

          // Jeda 120ms agar selaras setelah jingle nada pertama selesai
          setTimeout(() => {
            window.speechSynthesis.speak(utterance);
          }, 120);
        }
      } catch (e) {
        console.warn('SpeechSynthesis error:', e);
      }
    }

    function addToCart(prodId) {
      const prod = products.find(p => p.id === prodId);
      if (!prod) return;
      if (prod.stock <= 0) {
        showToast(`Stok ${prod.name} sudah habis!`, 'error');
        return;
      }

      const existing = cart.find(item => item.id === prodId);
      if (existing) {
        if (existing.qty >= prod.stock) {
          showToast(`Jumlah melebihi stok yang tersedia (${prod.stock})!`, 'error');
          return;
        }
        existing.qty += 1;
      } else {
        cart.push({
          id: prod.id,
          name: prod.name,
          price: prod.price,
          cost: prod.cost || 0,
          qty: 1,
          maxStock: prod.stock
        });
      }

      // Mainkan suara "tot tot" kasir dan sebutkan nama barang
      playCartBeep();
      playItemNameVoice(prod.name);

      renderCart();
    }

    function updateCartQty(prodId, delta) {
      const item = cart.find(i => i.id === prodId);
      if (!item) return;

      item.qty += delta;
      if (item.qty > item.maxStock) {
        item.qty = item.maxStock;
        showToast('Mencapai batas maksimum stok!', 'error');
      }

      if (item.qty <= 0) {
        cart = cart.filter(i => i.id !== prodId);
      } else if (delta > 0) {
        // Mainkan suara saat menambah kuantitas di keranjang (+) dan sebutkan nama barang
        playCartBeep();
        playItemNameVoice(item.name);
      }

      renderCart();
    }

