    function deleteBon(bonId) {
      if (!currentUser || currentUser.role !== 'Admin') {
        showToast('Akses ditolak! Hanya Administrator yang dapat menghapus data bon.', 'error');
        return;
      }

      const bonIndex = bons.findIndex(b => b.id === bonId);
      if (bonIndex === -1) {
        showToast('Data bon tidak ditemukan!', 'error');
        return;
      }

      const targetBon = bons[bonIndex];
      markRecordDeleted(bonId);

      // Jika bon belum lunas, kembalikan stok barang yang sebelumnya dikeluarkan
      if (targetBon.status === 'BELUM_LUNAS' && Array.isArray(targetBon.items)) {
        targetBon.items.forEach(item => {
          const prod = products.find(p => p.id === item.id || p.name === item.name);
          if (prod) {
            prod.stock = Number(prod.stock || 0) + Number(item.qty || 0);
          }
        });
        setStored(KEY_PRODUCTS, products);
      }

      bons.splice(bonIndex, 1);
      setStored(KEY_BONS, bons);
      immediateCloudSync(); // Sinkronisasi instan ke Cloud agar permanen

      renderBonTable();
      updateBonBadge();
      renderDashboard();
      renderPosCatalog();
      showToast(`Data bon untuk ${targetBon.playerName} berhasil dihapus!`, 'success');
    }

    function settleBon(bonId, defaultMethod = 'CASH') {
      const bon = bons.find(b => b.id === bonId);
      if (!bon) return;
      openPaymentModal(defaultMethod, bonId);
    }

