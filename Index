    async function findWritableCharacteristic(server) {
      const services = await server.getPrimaryServices();
      let fallbackChar = null;

      for (const service of services) {
        const uuid = String(service.uuid || '').toLowerCase();
        // Lewati Generic Access (1800) & Generic Attribute (1801) agar tidak salah menulis ke nama perangkat
        const isGenericService = uuid.startsWith('00001800') || uuid.startsWith('00001801') || uuid.startsWith('0000180a');

        try {
          const characteristics = await service.getCharacteristics();
          for (const char of characteristics) {
            if (char.properties.writeWithoutResponse || char.properties.write) {
              if (!isGenericService) {
                return char; // Prioritaskan characteristic milik service printer ESC/POS
              }
              if (!fallbackChar) {
                fallbackChar = char;
              }
            }
          }
        } catch (e) {
          console.warn('Skip service:', e);
        }
      }
      return fallbackChar;
    }

    async function connectGattAndGetChar(device) {
      if (!device || !device.gatt) {
        throw new Error('Perangkat Bluetooth tidak mendukung koneksi GATT.');
      }
      device.addEventListener('gattserverdisconnected', () => {
        bluetoothCharacteristic = null;
        refreshBtStatusUI();
      });

      const server = await device.gatt.connect();
      const char = await findWritableCharacteristic(server);
      if (!char) {
        throw new Error('Tidak ditemukan jalur cetak ESC/POS pada perangkat Bluetooth ini.');
      }

      bluetoothPrinterDevice = device;
      bluetoothCharacteristic = char;
      refreshBtStatusUI();
      return char;
    }

    // Rekoneksi latar belakang saat halaman dimuat (tidak mengganggu user gesture klik)
    async function trySilentBluetoothReconnect() {
      if (!navigator.bluetooth || typeof navigator.bluetooth.getDevices !== 'function') return;
      try {
        const permittedDevices = await navigator.bluetooth.getDevices();
        if (permittedDevices && permittedDevices.length > 0) {
          for (const dev of permittedDevices) {
            try {
              await connectGattAndGetChar(dev);
              return;
            } catch (e) {}
          }
        }
      } catch (e) {}
    }

    function disconnectBluetoothPrinter() {
      try {
        if (bluetoothPrinterDevice && bluetoothPrinterDevice.gatt && bluetoothPrinterDevice.gatt.connected) {
          bluetoothPrinterDevice.gatt.disconnect();
