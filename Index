        }
      });

      // Update styling nav buttons mobile
      document.querySelectorAll('.mobile-nav-btn').forEach(btn => {
        if (btn.getAttribute('data-mob-tab') === tabId) {
          btn.className = 'mobile-nav-btn flex items-center gap-2 p-2.5 rounded-xl bg-emerald-600 text-white font-bold transition-all text-xs';
