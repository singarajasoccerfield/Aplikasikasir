    function extractQrisPayloadFromImage(img) {
      if (typeof jsQR !== 'function') return '';
      // Coba pindai pada beberapa skala & area crop (termasuk tengah poster GoPay Merchant)
      const attempts = [
        { sx: 0, sy: 0, sw: img.width, sh: img.height, scale: 1.0 },
        { sx: 0, sy: 0, sw: img.width, sh: img.height, scale: Math.min(1.0, 900 / Math.max(img.width, img.height)) },
        { sx: img.width * 0.1, sy: img.height * 0.15, sw: img.width * 0.8, sh: img.height * 0.7, scale: 1.0 },
        { sx: img.width * 0.15, sy: img.height * 0.2, sw: img.width * 0.7, sh: img.height * 0.6, scale: 1.0 }
      ];

      for (const att of attempts) {
        try {
          const cw = Math.max(100, Math.round(att.sw * att.scale));
          const ch = Math.max(100, Math.round(att.sh * att.scale));
          const c = document.createElement('canvas');
          c.width = cw;
          c.height = ch;
          const cx = c.getContext('2d');
          cx.drawImage(img, att.sx, att.sy, att.sw, att.sh, 0, 0, cw, ch);
          const imgData = cx.getImageData(0, 0, cw, ch);
          const code = jsQR(imgData.data, imgData.width, imgData.height);
          if (code && code.data && code.data.trim().startsWith('000201')) {
            return code.data.trim();
          }
        } catch (err) {}
      }
      return '';
    }

