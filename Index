    // ==========================================
    // GENERATOR QRIS DINAMIS EMVCo (GOPAY MERCHANT / QRIS NASIONAL)
    // ==========================================
    function calculateCRC16CCITT(str) {
      let crc = 0xFFFF;
      for (let i = 0; i < str.length; i++) {
        crc ^= str.charCodeAt(i) << 8;
        for (let j = 0; j < 8; j++) {
          if ((crc & 0x8000) !== 0) {
            crc = ((crc << 1) ^ 0x1021) & 0xFFFF;
          } else {
            crc = (crc << 1) & 0xFFFF;
          }
        }
      }
      return crc.toString(16).toUpperCase().padStart(4, '0');
    }

    function parseQrisMerchantName(rawQris) {
      if (!rawQris || !rawQris.startsWith('000201')) return '';
      let i = 0;
      while (i < rawQris.length) {
        const tag = rawQris.substr(i, 2);
        const len = parseInt(rawQris.substr(i + 2, 2), 10);
        if (isNaN(len) || len < 0 || i + 4 + len > rawQris.length) break;
        const val = rawQris.substr(i + 4, len);
        if (tag === '59') return val;
        i += 4 + len;
      }
      return 'GoPay Merchant';
    }

    function generateDynamicQrisPayload(staticPayload, amount) {
      const cleanPayload = String(staticPayload || '').trim();
      if (!cleanPayload.startsWith('000201')) return null;

      const nominal = Math.round(Number(amount || 0));
      if (nominal <= 0) return cleanPayload;

      const amtStr = String(nominal);
      const tag54 = '54' + String(amtStr.length).padStart(2, '0') + amtStr;

      let i = 0;
      let rebuilt = '';
      let inserted54 = false;

      while (i < cleanPayload.length) {
        const tag = cleanPayload.substr(i, 2);
        const lenStr = cleanPayload.substr(i + 2, 2);
        const len = parseInt(lenStr, 10);

        if (isNaN(len) || len < 0 || i + 4 + len > cleanPayload.length) break;
        const val = cleanPayload.substr(i + 4, len);

        if (tag === '63') {
          break;
        } else if (tag === '01') {
          rebuilt += '010212';
        } else if (tag === '54') {
          // Lewati tag 54 lama jika ada
        } else {
          if (tag === '58' && !inserted54) {
            rebuilt += tag54;
            inserted54 = true;
          }
          rebuilt += tag + lenStr + val;
          if (tag === '53' && !inserted54) {
            rebuilt += tag54;
            inserted54 = true;
          }
        }
        i += 4 + len;
      }

      if (!inserted54) {
        rebuilt += tag54;
      }

      const payloadWithCrcHeader = rebuilt + '6304';
      const newCrc = calculateCRC16CCITT(payloadWithCrcHeader);
      return payloadWithCrcHeader + newCrc;
    }

