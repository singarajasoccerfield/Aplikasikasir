          '3. Klik tombol biru <b>"Scan & Pilih Printer Bluetooth"</b> di bawah untuk memunculkan pop-up kembali.'
        );
        return;
      }

      // Jika lebih dari 450ms dan NotFoundError, pengguna menutup sendiri pop-up pemilihan
      if (errName === 'NotFoundError') {
