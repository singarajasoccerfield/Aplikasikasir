      window.calculateClosingDiff = function() {
        const targetDate = getSelectedClosingDate();
        const starting = Number(document.getElementById('closingStartingCash')?.value || 0);
        const rawActual = document.getElementById('closingActualCash')?.value ?? '';

        const sysCash = transactions
          .filter(t => getLocalDateString(t.date) === targetDate && t.method === 'CASH')
          .reduce((sum, t) => sum + Number(t.total || 0), 0);

        const dateExpKasir = expenses
          .filter(e => getLocalDateString(e.date) === targetDate && e.category === 'KASIR')
          .reduce((sum, e) => sum + Number(e.amount || 0), 0);

        const expected = starting + sysCash - dateExpKasir;
        const actual = rawActual.trim() === '' ? expected : Number(rawActual || 0);
        const diff = actual - expected;

        const expEl = document.getElementById('closeExpectedCash');
        if (expEl) expEl.innerText = formatRupiah(expected);

        const diffEl = document.getElementById('closeDiffLabel');
        if (diffEl) {
          if (rawActual.trim() === '') {
            diffEl.innerText = `Rp 0 (Otomatis Sesuai Sistem: ${formatRupiah(expected)})`;
            diffEl.className = 'font-mono text-emerald-400 font-bold';
          } else if (diff === 0) {
            diffEl.innerText = 'Rp 0 (Pas / Seimbang)';
            diffEl.className = 'font-mono text-emerald-400 font-bold';
          } else if (diff > 0) {
            diffEl.innerText = `+${formatRupiah(diff)} (Surplus / Lebih)`;
            diffEl.className = 'font-mono text-blue-400 font-bold';
          } else {
            diffEl.innerText = `-${formatRupiah(Math.abs(diff))} (Minus / Kurang)`;
            diffEl.className = 'font-mono text-rose-400 font-bold';
          }
        }
      };

