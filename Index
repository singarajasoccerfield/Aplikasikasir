    function handleLogin() {
      const usernameInput = document.getElementById('loginUsername').value.trim();
      const passwordInput = document.getElementById('loginPassword').value.trim();
      const errBox = document.getElementById('loginErrorAlert');
      const errText = document.getElementById('loginErrorText');

      if (!usernameInput || !passwordInput) {
        errText.innerText = 'Username dan Password wajib diisi!';
        errBox.classList.remove('hidden');
        shakeLoginOverlay();
        return;
      }

      // Pastikan daftar akun pengguna selalu valid (fallback ke defaultUsers jika kosong/corrupt)
      if (!Array.isArray(users) || users.length === 0) {
        users = [...defaultUsers];
      }

      // Validasi dan cari akun di Database Pengguna (cek juga defaultUsers jika belum tersinkron)
      const foundUser = users.find(u => 
        u && u.username && u.username.toLowerCase() === usernameInput.toLowerCase() && 
        String(u.password) === String(passwordInput)
      ) || defaultUsers.find(u =>
        u.username.toLowerCase() === usernameInput.toLowerCase() &&
        String(u.password) === String(passwordInput)
      );

      if (!foundUser) {
        errText.innerText = 'Kombinasi Username atau Password salah!';
        errBox.classList.remove('hidden');
        shakeLoginOverlay();
        return;
      }

      // Login Berhasil: Peran dideteksi otomatis dari data akun (Admin atau Kasir)
      errBox.classList.add('hidden');
      currentUser = { 
        id: foundUser.id,
        role: foundUser.role, 
        name: foundUser.name || foundUser.username,
        username: foundUser.username
      };

      // Simpan Sesi Login agar tidak logout saat refresh
      setStored(KEY_AUTH_SESSION, currentUser);

      document.getElementById('loginPassword').value = '';
      document.getElementById('loginOverlay').classList.add('hidden');
      applyRolePermissions();
      const lastActiveTab = localStorage.getItem(KEY_ACTIVE_TAB) || 'dashboard';
      switchTab(lastActiveTab);
      showToast(`Selamat datang, ${currentUser.name} (${currentUser.role})!`, 'success');
    }

    function shakeLoginOverlay() {
      const overlayBox = document.querySelector('#loginOverlay > div');
      if (overlayBox) {
        overlayBox.classList.add('animate-bounce');
        setTimeout(() => overlayBox.classList.remove('animate-bounce'), 500);
      }
    }

    function handleLogout() {
      document.getElementById('loginUsername').value = '';
      document.getElementById('loginPassword').value = '';
      const errBox = document.getElementById('loginErrorAlert');
      if (errBox) errBox.classList.add('hidden');
      currentUser = null;
      // Hapus Sesi Login dan Tab Aktif saat logout manual
      localStorage.removeItem(KEY_AUTH_SESSION);
      try {
        localStorage.removeItem(KEY_ACTIVE_TAB);
      } catch (e) {}
      document.body.classList.remove('role-kasir-active');
      document.getElementById('loginOverlay').classList.remove('hidden');
      showToast('Anda telah keluar dari sistem.', 'info');
    }

