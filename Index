      // Simpan tab aktif ke localStorage agar tidak reset saat refresh
      try {
        localStorage.setItem(KEY_ACTIVE_TAB, tabId);
      } catch (e) {}

      // Sembunyikan semua section
      const allSections = document.querySelectorAll('main > section');
      allSections.forEach(sec => sec.classList.add('hidden'));

      // Tampilkan target section
      const targetSec = document.getElementById(`section-${tabId}`);
      if (targetSec) targetSec.classList.remove('hidden');

      // Update styling nav buttons desktop
      document.querySelectorAll('.nav-tab').forEach(btn => {
        if (btn.getAttribute('data-tab') === tabId) {
          btn.className = 'nav-tab active flex items-center gap-2 px-3 py-2 rounded-xl text-white bg-emerald-600 transition-all text-xs font-bold shadow-md shadow-emerald-600/20';
