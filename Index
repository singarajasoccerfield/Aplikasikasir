            cashierNames.map(name => `<option value="${name}">${name}</option>`).join('');

          selectCashier.value = currentVal;
        }
      }

      // Pastikan tanggal mulai & akhir langsung otomatis terisi tanggal lokal hari ini saat dibuka
      const startInput = document.getElementById('reportFilterStartDate');
      const endInput = document.getElementById('reportFilterEndDate');
      const todayStr = getLocalDateString(new Date());
      if (startInput) startInput.value = todayStr;
      if (endInput) endInput.value = todayStr;

      renderFilteredSalesReport();
    }

    function setReportDateRange(type) {
      const startInput = document.getElementById('reportFilterStartDate');
      const endInput = document.getElementById('reportFilterEndDate');
      if (!startInput || !endInput) return;

      const now = new Date();
      const todayStr = getLocalDateString(now);

      if (type === 'TODAY') {
        startInput.value = todayStr;
        endInput.value = todayStr;
      } else if (type === 'YESTERDAY') {
        const yest = new Date(now);
        yest.setDate(yest.getDate() - 1);
        const yestStr = getLocalDateString(yest);
        startInput.value = yestStr;
        endInput.value = yestStr;
      } else if (type === 'LAST7') {
        const past7 = new Date(now);
        past7.setDate(past7.getDate() - 6);
        startInput.value = getLocalDateString(past7);
        endInput.value = todayStr;
      } else if (type === 'THISMONTH') {
        const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
        startInput.value = getLocalDateString(firstDay);
        endInput.value = todayStr;
      } else if (type === 'ALL') {
        startInput.value = '';
        endInput.value = '';
      }

      renderFilteredSalesReport();
    }

    function getFilteredSalesData() {
      const startDate = document.getElementById('reportFilterStartDate')?.value || '';
      const endDate = document.getElementById('reportFilterEndDate')?.value || '';
      const filterMethod = document.getElementById('reportFilterMethod')?.value || 'ALL';
      const isKasir = currentUser && currentUser.role === 'Kasir';

      // Jika kasir login: paksa filter hanya nama kasir yang bersangkutan
      let targetCashier = 'ALL';
      if (isKasir) {
        targetCashier = currentUser.name;
      } else {
        targetCashier = document.getElementById('reportFilterCashier')?.value || 'ALL';
      }

      return transactions.filter(t => {
        // Ambil tanggal lokal transaksi secara akurat
        const trxDateOnly = getLocalDateString(t.date);

        // Filter Tanggal Mulai
        if (startDate && trxDateOnly < startDate) return false;

        // Filter Tanggal Akhir
        if (endDate && trxDateOnly > endDate) return false;

        // Filter Nama Kasir (Kasir hanya melihat datanya sendiri, Admin bisa melihat semua)
        if (targetCashier !== 'ALL') {
          if ((t.cashier || '').toLowerCase() !== targetCashier.toLowerCase()) return false;
        }

        // Filter Metode Pembayaran
        if (filterMethod !== 'ALL') {
          if ((t.method || '').toUpperCase() !== filterMethod.toUpperCase()) return false;
        }

        return true;
      });
    }

