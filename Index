    async function initAutoFirebaseIntegration() {
      if (!window.FB_SDK) return;
      try {
        updateCloudSyncStatus('SYNCING', 'Menghubungkan Cloud...');
        const client = initFirebaseClient();
        if (!client) {
          updateCloudSyncStatus('ERROR', 'Gagal Init SDK');
          return;
        }

        // Login Anonim Otomatis
        if (!client.fbAuth.currentUser) {
          const cred = await window.FB_SDK.signInAnonymously(client.fbAuth);
          fbUser = cred.user;
        } else {
          fbUser = client.fbAuth.currentUser;
        }

        isCloudReady = true;
        updateCloudSyncStatus('ONLINE', 'Cloud Aktif');

        // Tarik & gabungkan data terbaru dari cloud (tanpa menimpa data lokal yang baru disimpan)
        await pullLatestDataFromFirebaseCloud();

        // Jika ada penyimpanan lokal saat cloud baru terhubung, dorong ke cloud sekarang
