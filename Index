          }
        });

        // 2. Doughnut Chart: Proporsi Pembayaran
        let cashCount = 0;
        let qrisCount = 0;
        (transactions || []).forEach(t => {
          if (t.method === 'CASH') cashCount += Number(t.total || 0);
          if (t.method === 'QRIS') qrisCount += Number(t.total || 0);
        });

        if (methodChart) {
          try { methodChart.destroy(); } catch (e) {}
          methodChart = null;
        }

        const methodCtx = methodCanvas.getContext('2d');
        const hasData = (cashCount > 0 || qrisCount > 0);

        methodChart = new Chart(methodCtx, {
          type: 'doughnut',
          data: {
            labels: hasData ? ['Cash (Tunai)', 'QRIS (Non-Tunai)'] : ['Belum Ada Transaksi'],
            datasets: [{
              data: hasData ? [cashCount, qrisCount] : [1],
              backgroundColor: hasData ? ['#10b981', '#14b8a6'] : ['#334155'],
              borderWidth: 2,
              borderColor: '#0f172a'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '70%',
            animation: { duration: 600 },
            plugins: { 
              legend: { 
                position: 'bottom', 
                labels: { 
                  color: '#94a3b8',
                  boxWidth: 12,
                  padding: 14,
                  font: { size: 11, family: 'Inter' }
                } 
              },
              tooltip: {
                backgroundColor: '#0f172a',
                titleColor: '#f8fafc',
                bodyColor: '#38bdf8',
                borderColor: '#1e293b',
                borderWidth: 1,
                callbacks: {
                  label: function(context) {
                    if (!hasData) return ' Belum ada data transaksi';
                    return ' ' + context.label + ': ' + formatRupiah(context.raw);
                  }
                }
              }
            }
          }
        });
      } catch (e) {
        console.error('Error saat merender chart:', e);
      }
    }

