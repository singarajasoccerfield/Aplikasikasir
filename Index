    }

    function formatEscPosLine(leftText, rightText, maxLen = 32) {
      const cleanLeft = String(leftText || '');
      const cleanRight = String(rightText || '');
      const spaces = Math.max(1, maxLen - cleanLeft.length - cleanRight.length);
      return cleanLeft + ' '.repeat(spaces) + cleanRight + '\n';
    }

    function buildEscPosReceiptBytes(trx) {
      const encoder = new TextEncoder();
      const chunks = [];
      const pushBytes = (arr) => chunks.push(new Uint8Array(arr));
      const pushText = (str) => chunks.push(encoder.encode(str));

      const dateStr = trx.date ? new Date(trx.date).toLocaleString('id-ID') : '-';
      const cashierStr = trx.cashier || 'Kasir';
      const noStr = trx.receiptNo || trx.id || '-';

      // Inisialisasi Printer (ESC @)
      pushBytes([0x1B, 0x40]);

      // Align Center (ESC a 1) & Bold ON (ESC E 1)
      pushBytes([0x1B, 0x61, 0x01]);
      pushBytes([0x1B, 0x45, 0x01]);
      pushText('SINGARAJA SOCCERFIELD\n');
      pushBytes([0x1B, 0x45, 0x00]); // Bold OFF
      pushText('Jl. Pulau Dewata 3, Pemaron\n');
      pushText('WA: 085137770828\n');
      pushText('--------------------------------\n');

      // Align Left (ESC a 0)
      pushBytes([0x1B, 0x61, 0x00]);
      pushText(`Tgl  : ${dateStr}\n`);
      pushText(`Kasir: ${cashierStr}\n`);
      pushText(`No   : ${noStr}\n`);
      pushText('--------------------------------\n');

      // Daftar Barang
      (trx.items || []).forEach(item => {
        const itemName = String(item.name || 'Item').slice(0, 32);
        const qtyPrice = `${item.qty}x ${Number(item.price || 0).toLocaleString('id-ID')}`;
        const subTotal = formatRupiah((item.price || 0) * (item.qty || 1));
        pushText(itemName + '\n');
        pushText(formatEscPosLine('  ' + qtyPrice, subTotal, 32));
      });

      pushText('--------------------------------\n');

      // Ringkasan Total (Bold ON untuk Total)
      pushBytes([0x1B, 0x45, 0x01]);
      pushText(formatEscPosLine('Total Tagihan:', formatRupiah(trx.total), 32));
      pushBytes([0x1B, 0x45, 0x00]);

      pushText(formatEscPosLine('Metode Bayar:', String(trx.method || 'CASH'), 32));
      if ((trx.method || 'CASH') === 'CASH') {
        pushText(formatEscPosLine('Bayar:', formatRupiah(trx.cashReceived || trx.total), 32));
        pushText(formatEscPosLine('Kembalian:', formatRupiah(trx.change || 0), 32));
      }

      pushText('--------------------------------\n');

      // Footer Center & Feed 3 baris
      pushBytes([0x1B, 0x61, 0x01]);
      pushText('Matur Suksma sampun mampir!\n');
      pushText('Salam Olahraga & Fairplay\n\n\n');
      pushBytes([0x1B, 0x64, 0x03]);

      const totalLength = chunks.reduce((acc, c) => acc + c.length, 0);
      const combined = new Uint8Array(totalLength);
      let offset = 0;
      for (const c of chunks) {
        combined.set(c, offset);
        offset += c.length;
      }
      return combined;
    }

    async function sendEscPosToCharacteristic(char, trx) {
      if (isBtPrinting) {
        showToast('Sedang mengirim cetakan ke printer...', 'info');
        return;
      }
      try {
        isBtPrinting = true;
        const dataBytes = buildEscPosReceiptBytes(trx);
        const CHUNK_SIZE = 20;
        for (let i = 0; i < dataBytes.length; i += CHUNK_SIZE) {
          const slice = dataBytes.slice(i, i + CHUNK_SIZE);
          if (char.properties.writeWithoutResponse && typeof char.writeValueWithoutResponse === 'function') {
            await char.writeValueWithoutResponse(slice);
          } else {
            await char.writeValue(slice);
          }
          await new Promise(res => setTimeout(res, 15));
        }
        showToast('Nota berhasil dicetak ke Printer Bluetooth 58mm!', 'success');
        closeModal('paymentSuccessModal');
      } catch (err) {
        console.error('Write ESC/POS error:', err);
        bluetoothCharacteristic = null;
        refreshBtStatusUI();
        pendingBtPrintTransaction = trx;
        openBtPrinterModal(trx);
        showBtDiagnosticAlert(
          'Koneksi ke Printer Terputus Saat Mencetak',
          'Silakan klik tombol <b>"Pilih Printer Bluetooth & Langsung Cetak Nota"</b> di bawah untuk menyambungkan ulang dan mencetak.'
        );
      } finally {
        isBtPrinting = false;
      }
    }

    function printViaRawBtIntent(trx) {
      if (!trx) return;
      try {
        const bytes = buildEscPosReceiptBytes(trx);
        let binary = '';
        for (let i = 0; i < bytes.byteLength; i++) {
          binary += String.fromCharCode(bytes[i]);
        }
        const base64Data = window.btoa(binary);
        window.location.href = 'rawbt:base64,' + base64Data;
        closeModal('paymentSuccessModal');
      } catch (e) {
        showToast('Gagal mengirim intent cetak: ' + e.message, 'error');
      }
    }

    function printViaBluetoothDirect(trx) {
      if (!trx) return;
      pendingBtPrintTransaction = trx;

      // Mode 2: Cetak Sistem Android / USB (window.print)
      if (btPrintMode === 'SYSTEM_PRINT') {
        printReceiptBrowserFallback(trx);
        return;
      }

      // Mode 3: Jalur Bluetooth Classic SPP / Intent
      if (btPrintMode === 'RAWBT_INTENT') {
        printViaRawBtIntent(trx);
        return;
      }

      // Mode 1 (Default): Web Bluetooth Langsung (BLE_DIRECT)
      // A. Jika printer sudah terhubung aktif, langsung kirim byte ESC/POS tanpa pop-up lagi
      if (isBtPrinterConnected()) {
        sendEscPosToCharacteristic(bluetoothCharacteristic, trx);
        return;
      }

      // B. Jika belum terhubung: PANGGIL requestDevice() SECARA SINKRON DI BARIS PERTAMA!
      const clickStartTime = Date.now();
      let devicePromise;
      try {
        devicePromise = requestBluetoothPrinterSynchronously();
      } catch (syncErr) {
        devicePromise = Promise.reject(syncErr);
      }

      devicePromise
        .then(async (device) => {
          showToast(`Menghubungkan ke ${device.name || 'Printer 58mm'}...`, 'info');
          const char = await connectGattAndGetChar(device);
          pendingBtPrintTransaction = null;
          await sendEscPosToCharacteristic(char, trx);
        })
        .catch((err) => {
          const elapsed = Date.now() - clickStartTime;
          handleBluetoothPopupError(err, elapsed);
        });
    }

