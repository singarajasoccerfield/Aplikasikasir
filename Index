    function handleBluetoothPopupError(err, elapsedMs) {
      console.warn('Bluetooth requestDevice error:', err, 'Elapsed:', elapsedMs);
      const errMsg = String((err && err.message) || err || '');
      const errName = String((err && err.name) || '');

      if (errMsg.includes('WEB_BLUETOOTH_UNSUPPORTED') || !navigator.bluetooth) {
        openBtPrinterModal();
        showBtDiagnosticAlert(
          'WebView Tidak Mendukung Pop-up Bluetooth',
          'Aplikasi saat ini dibuka di dalam WebView yang tidak memiliki fitur pop-up Bluetooth Chrome. <br><b>Solusi:</b> Buka link aplikasi di browser <b>Google Chrome</b> lalu pilih <b>Install Aplikasi</b>, atau ubah Metode Cetak di bawah ke <b>Nomor 2 (Sistem)</b> atau <b>Nomor 3 (Jalur SPP/Intent)</b>.'
        );
        return;
      }

      // Jika gagal sangat cepat (< 450ms), berarti pop-up sama sekali tidak ditampilkan oleh sistem Android/Chrome
      if (elapsedMs < 450 || errName === 'SecurityError' || errMsg.toLowerCase().includes('gesture') || errMsg.toLowerCase().includes('adapter') || errMsg.toLowerCase().includes('location')) {
        openBtPrinterModal();
        showBtDiagnosticAlert(
          'Pop-up Pemilihan Bluetooth Diblokir oleh HP / Browser',
          'Sistem Android menolak memunculkan daftar printer Bluetooth.<br>' +
