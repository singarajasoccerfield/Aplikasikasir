    // ==========================================
    function renderClosingDashboard() {
      const todayStr = getLocalDateString(new Date());
      const todayTrx = transactions.filter(t => getLocalDateString(t.date) === todayStr);

      let sysCash = 0, sysQris = 0;
      todayTrx.forEach(t => {
        if (t.method === 'CASH') sysCash += Number(t.total || 0);
        if (t.method === 'QRIS') sysQris += Number(t.total || 0);
      });

      const todayExpKasir = expenses
        .filter(e => getLocalDateString(e.date) === todayStr && e.category === 'KASIR')
        .reduce((sum, e) => sum + Number(e.amount || 0), 0);

      document.getElementById('closeSysCash').innerText = formatRupiah(sysCash);
      document.getElementById('closeSysQris').innerText = formatRupiah(sysQris);
      document.getElementById('closeSysExpense').innerText = formatRupiah(todayExpKasir);

      calculateClosingDiff();
      renderClosingHistory();
    }

    function calculateClosingDiff() {
      const starting = Number(document.getElementById('closingStartingCash')?.value || 0);
      const actual = Number(document.getElementById('closingActualCash')?.value || 0);

      const todayStr = getLocalDateString(new Date());
      const sysCash = transactions
        .filter(t => getLocalDateString(t.date) === todayStr && t.method === 'CASH')
        .reduce((sum, t) => sum + Number(t.total || 0), 0);

      const todayExpKasir = expenses
        .filter(e => getLocalDateString(e.date) === todayStr && e.category === 'KASIR')
        .reduce((sum, e) => sum + Number(e.amount || 0), 0);

      const expected = starting + sysCash - todayExpKasir;
      const diff = actual - expected;

      document.getElementById('closeExpectedCash').innerText = formatRupiah(expected);
      const diffEl = document.getElementById('closeDiffLabel');

      if (diffEl) {
        if (actual === 0 && !document.getElementById('closingActualCash')?.value) {
          diffEl.innerText = 'Menunggu input uang fisik';
          diffEl.className = 'font-mono text-slate-400';
        } else if (diff === 0) {
          diffEl.innerText = 'Rp 0 (Pas / Seimbang)';
          diffEl.className = 'font-mono text-emerald-400 font-bold';
        } else if (diff > 0) {
          diffEl.innerText = `+${formatRupiah(diff)} (Surplus / Lebih)`;
          diffEl.className = 'font-mono text-blue-400 font-bold';
        } else {
          diffEl.innerText = `-${formatRupiah(Math.abs(diff))} (Minus / Kurang)`;
          diffEl.className = 'font-mono text-rose-400 font-bold';
        }
      }
    }

    function saveClosingRecord() {
      const actualInputEl = document.getElementById('closingActualCash');
      const rawActualVal = actualInputEl ? actualInputEl.value.trim() : '';
      if (rawActualVal === '') {
        showToast('Mohon isi nominal Hitungan Uang Fisik Kasir di laci terlebih dahulu!', 'error');
        if (actualInputEl) actualInputEl.focus();
        return;
      }

      const starting = Number(document.getElementById('closingStartingCash')?.value || 0);
      const actual = Number(rawActualVal || 0);
      const notes = document.getElementById('closingNotes')?.value.trim() || '-';

      const todayStr = getLocalDateString(new Date());
      const todayTrx = transactions.filter(t => getLocalDateString(t.date) === todayStr);

      let sysCash = 0, sysQris = 0;
      todayTrx.forEach(t => {
        if (t.method === 'CASH') sysCash += Number(t.total || 0);
        if (t.method === 'QRIS') sysQris += Number(t.total || 0);
      });

      const todayExpKasir = expenses
        .filter(e => getLocalDateString(e.date) === todayStr && e.category === 'KASIR')
        .reduce((sum, e) => sum + Number(e.amount || 0), 0);

      const expected = starting + sysCash - todayExpKasir;
      const diff = actual - expected;

      const record = {
        id: 'CLS-' + Date.now() + '-' + Math.floor(Math.random() * 1000),
        date: todayStr,
        timestamp: new Date().toISOString(),
        cashierName: currentUser ? currentUser.name : 'Kasir',
        startingCash: starting,
        cashSales: sysCash,
        qrisSales: sysQris,
        kasirExpenses: todayExpKasir,
        actualCash: actual,
        expectedCash: expected,
        difference: diff,
        notes: notes
      };

      if (!Array.isArray(closings)) closings = [];
      closings.push(record);
      setStored(KEY_CLOSINGS, closings);
      immediateCloudSync();
      syncClosingToWebhook(record);

      if (actualInputEl) actualInputEl.value = '';
      const notesEl = document.getElementById('closingNotes');
      if (notesEl) notesEl.value = '';

      calculateClosingDiff();
      renderClosingHistory();
      showToast('✅ Rekap tutup kasir harian berhasil disimpan ke Database Cloud!', 'success');
    }

    function renderClosingHistory() {
      const body = document.getElementById('closingHistoryBody');
      if (!body) return;

      closings = cleanDatasetArray(closings, 'id');

      if (closings.length === 0) {
        body.innerHTML = `<tr><td colspan="5" class="p-4 text-center text-slate-500">Belum ada riwayat tutup kasir.</td></tr>`;
        return;
      }

      const sortedClosings = closings.slice().sort((a, b) => {
        const tA = a.timestamp || a.date || '';
        const tB = b.timestamp || b.date || '';
        return tB.localeCompare(tA);
      });

      body.innerHTML = sortedClosings.map(c => {
        const diffVal = Number(c.difference || 0);
        const diffColor = diffVal < 0 ? 'text-rose-400 font-bold' : (diffVal > 0 ? 'text-blue-400 font-bold' : 'text-emerald-400 font-bold');
        const diffPrefix = diffVal > 0 ? '+' : '';
        return `
        <tr class="hover:bg-slate-800/40">
          <td class="p-3 text-slate-400 whitespace-nowrap">
            <span class="block text-white font-semibold">${c.date || '-'}</span>
            <span class="block text-[10px] text-slate-500">${c.notes && c.notes !== '-' ? c.notes : 'Shift terkunci'}</span>
          </td>
          <td class="p-3 text-white font-bold whitespace-nowrap">${c.cashierName || 'Kasir'}</td>
          <td class="p-3 text-emerald-400 font-mono whitespace-nowrap">
            <span class="block font-bold">${formatRupiah(c.actualCash)}</span>
            <span class="block text-[10px] text-slate-500">Sistem: ${formatRupiah(c.expectedCash)}</span>
          </td>
          <td class="p-3 font-mono whitespace-nowrap ${diffColor}">${diffPrefix}${formatRupiah(diffVal)}</td>
          <td class="p-3 text-center whitespace-nowrap">
            <button type="button" onclick="deleteClosingRecord('${c.id}')" title="Hapus Riwayat Tutup Kasir" class="p-1.5 rounded-lg bg-rose-950/40 hover:bg-rose-900/70 text-rose-400 transition-all inline-flex items-center gap-1 text-[11px]">
