    // PENTING: Panggil navigator.bluetooth.requestDevice() SECARA SINKRON di baris pertama klik!
    function requestBluetoothPrinterSynchronously() {
      if (!navigator.bluetooth || typeof navigator.bluetooth.requestDevice !== 'function') {
        return Promise.reject(new Error('WEB_BLUETOOTH_UNSUPPORTED'));
      }
      // Jangan pernah menaruh await sebelum baris ini agar User Gesture Chrome tidak hilang!
      return navigator.bluetooth.requestDevice({
        acceptAllDevices: true,
        optionalServices: BT_PRINTER_SERVICES
      });
    }

