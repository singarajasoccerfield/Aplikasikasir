    function autoCalculateBookingPrice() {
      const dateVal = document.getElementById('bkgDate')?.value;
      const startVal = document.getElementById('bkgStart')?.value;
      const endVal = document.getElementById('bkgEnd')?.value;

      if (!dateVal || !startVal || !endVal) return 0;

      const dateObj = new Date(dateVal);
      const day = dateObj.getDay();
      const isWeekend = (day === 0 || day === 6); // Sun or Sat

      const dayBadge = document.getElementById('bkgDayTypeBadge');
      if (dayBadge) {
        dayBadge.innerText = isWeekend ? 'Weekend (Sabtu-Minggu)' : 'Weekday (Senin-Jumat)';
        dayBadge.className = isWeekend ? 'text-amber-400 font-bold' : 'text-emerald-400 font-bold';
      }

      const startH = parseInt(startVal.split(':')[0], 10);
      const endH = parseInt(endVal.split(':')[0], 10);
      const hours = Math.max(1, endH - startH);

      let ratePerHour = 650000;
      if (isWeekend) {
        if (startH < 10) ratePerHour = rentalRates.weMorning;
        else if (startH < 16) ratePerHour = rentalRates.weDay;
        else ratePerHour = rentalRates.weNight;
      } else {
        if (startH < 10) ratePerHour = rentalRates.wdMorning;
        else if (startH < 16) ratePerHour = rentalRates.wdDay;
        else ratePerHour = rentalRates.wdNight;
      }

      const standardTotal = ratePerHour * hours;
      const discount = Math.max(0, Number(document.getElementById('bkgDiscount')?.value || 0));
      const netTotal = Math.max(0, standardTotal - discount);

      const stdEl = document.getElementById('bkgStandardPrice');
      if (stdEl) stdEl.innerText = formatRupiah(standardTotal);

      const netEl = document.getElementById('bkgAutoPrice');
      if (netEl) netEl.innerText = formatRupiah(netTotal);

      return netTotal;
    }

    function saveBookingData() {
      const name = document.getElementById('bkgName')?.value.trim();
      const phone = document.getElementById('bkgPhone')?.value.trim();
      const date = document.getElementById('bkgDate')?.value;
      const start = document.getElementById('bkgStart')?.value;
      const end = document.getElementById('bkgEnd')?.value;
      const discount = Math.max(0, Number(document.getElementById('bkgDiscount')?.value || 0));
      const dp = Number(document.getElementById('bkgDp')?.value || 0);
      const status = document.getElementById('bkgStatus')?.value;
      const notes = document.getElementById('bkgNotes')?.value.trim() || '-';

      if (!name || !phone || !date || !start || !end) {
        showToast('Mohon lengkapi semua data wajib!', 'error');
        return;
      }

      // Check Overlap
      const isOverlap = bookings.some(b => {
        if (b.date !== date) return false;
        return (start < b.endTime && end > b.startTime);
      });

      if (isOverlap) {
        showToast('Jadwal bentrok dengan bookingan lain pada jam tersebut!', 'error');
        return;
      }

      const totalPrice = autoCalculateBookingPrice();

      const booking = {
        bookingId: 'BKG-' + Date.now().toString().slice(-6),
        customerName: name,
        phone: phone,
        date: date,
        startTime: start,
        endTime: end,
        discount: discount,
        totalPrice: totalPrice,
        downPayment: dp,
        paymentStatus: status,
        notes: notes
      };

      bookings.push(booking);
      setStored(KEY_BOOKINGS, bookings);
      immediateCloudSync();
      closeModal('bookingModal');
      renderBookingList();
      showToast('Booking lapangan berhasil disimpan!', 'success');
    }

