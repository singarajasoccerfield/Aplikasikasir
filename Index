    function handleUploadQrisImage(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (evt) => {
        const img = new Image();
        img.onload = () => {
          // 1. Ekstrak Payload EMVCo QRIS Statis GoPay Merchant untuk dikonversi ke Dinamis
          const extractedPayload = extractQrisPayloadFromImage(img);

          // 2. Kompres gambar untuk cadangan tampilan
          const MAX_SIZE = 500;
          let width = img.width;
          let height = img.height;
          if (width > height) {
            if (width > MAX_SIZE) {
              height = Math.round((height * MAX_SIZE) / width);
              width = MAX_SIZE;
            }
          } else {
            if (height > MAX_SIZE) {
              width = Math.round((width * MAX_SIZE) / height);
              height = MAX_SIZE;
            }
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          customQrisUrl = canvas.toDataURL('image/jpeg', 0.85);
          setStored(KEY_QRIS, customQrisUrl);

          if (extractedPayload) {
            customQrisPayload = extractedPayload;
            setStored(KEY_QRIS_PAYLOAD, customQrisPayload);
            immediateCloudSync();
            const mName = parseQrisMerchantName(extractedPayload);
            showToast(`⚡ QRIS GoPay Merchant (${mName}) terdeteksi! Mode QRIS Dinamis Otomatis Aktif!`, 'success');
          } else {
            showToast('Foto QRIS disimpan (Statis). Untuk Auto-Dinamis, pastikan barcode QRIS terlihat jelas & tidak terpotong.', 'info');
          }

          renderIntegrationSettings();
        };
        img.src = evt.target.result;
      };
      reader.readAsDataURL(file);
    }

