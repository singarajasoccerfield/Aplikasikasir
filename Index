    function deleteSalesTransaction(trxId) {
      if (!currentUser || currentUser.role !== 'Admin') {
        showToast('Akses ditolak! Hanya Administrator yang dapat menghapus transaksi penjualan.', 'error');
        return;
      }

      const trxIndex = transactions.findIndex(t => t.id === trxId);
      if (trxIndex === -1) {
        showToast('Data transaksi tidak ditemukan!', 'error');
        return;
      }

      const targetTrx = transactions[trxIndex];
      markRecordDeleted(trxId);

      // Kembalikan stok barang yang sebelumnya terjual (Rollback Stock)
      if (Array.isArray(targetTrx.items)) {
        targetTrx.items.forEach(item => {
          const prod = products.find(p => p.id === item.id || p.name === item.name);
          if (prod) {
            prod.stock = Number(prod.stock || 0) + Number(item.qty || 0);
          }
        });
        setStored(KEY_PRODUCTS, products);
      }

      // Hapus data transaksi dari list
      transactions.splice(trxIndex, 1);
      setStored(KEY_TRANSACTIONS, transactions);
      immediateCloudSync(); // Sinkronisasi instan ke Cloud agar permanen

      // Refresh seluruh tampilan data terkait
      renderFilteredSalesReport();
      renderDashboard();
      renderPosCatalog();
      renderInventoryTable();
      showToast(`Transaksi ${targetTrx.receiptNo || targetTrx.id} berhasil dihapus & stok barang telah dikembalikan!`, 'success');
    }

