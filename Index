      markRecordDeleted(closingId);
      closings.splice(closingIndex, 1);
      setStored(KEY_CLOSINGS, closings);
      immediateCloudSync(); // Sinkronisasi instan ke Cloud agar permanen
      renderClosingHistory();
      showToast(`Catatan tutup kasir (${target.date}) berhasil dihapus permanen.`, 'success');
