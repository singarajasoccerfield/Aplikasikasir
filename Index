      var folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(folderName);
      
      var decoded = Utilities.base64Decode(data.base64Data);
      var blob = Utilities.newBlob(decoded, data.mimeType || "image/jpeg", data.fileName || ("img_" + Date.now() + ".jpg"));
      
      var file = folder.createFile(blob);
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      
      var directUrl = "https://drive.google.com/thumbnail?id=" + file.getId() + "&sz=w600";
      
      return ContentService.createTextOutput(JSON.stringify({
        status: "success",
        fileUrl: directUrl,
        fileId: file.getId()
      })).setMimeType(ContentService.MimeType.JSON);
    }

    // 2. FITUR PENCATATAN KE GOOGLE SPREADSHEET
    var ss = SpreadsheetApp.getActiveSpreadsheet();
    setupSheets(ss);
    var p = data.payload || data;

    if (data.type === "SALE") {
      var sheetSale = ss.getSheetByName("Penjualan_Kasir");
