    async function handleProductImageUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const webhookUrl = savedWebhookUrl || getStored(KEY_WEBHOOK, '');
      const previewImg = document.getElementById('productPreviewImg');

      // KUNCI TOMBOL SIMPAN BARANG
      setProductSaveButtonLoading(true);
      showToast('Memproses dan mengompres foto barang...', 'info');

      const reader = new FileReader();
      reader.onerror = () => {
        setProductSaveButtonLoading(false, '<span class="text-rose-400">❌ Gagal membaca file gambar</span>');
        showToast('Gagal membaca file gambar!', 'error');
      };

      reader.onload = async (event) => {
        const img = new Image();
        img.onerror = () => {
          setProductSaveButtonLoading(false, '<span class="text-rose-400">❌ Format gambar tidak valid</span>');
          showToast('Gambar tidak valid!', 'error');
        };

        img.onload = async () => {
          // Kompresi resolusi gambar (maksimal lebar/tinggi 500px)
          const MAX_SIZE = 500;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > MAX_SIZE) {
              height = Math.round((height * MAX_SIZE) / width);
              width = MAX_SIZE;
            }
          } else {
            if (height > MAX_SIZE) {
              width = Math.round((width * MAX_SIZE) / height);
              height = MAX_SIZE;
            }
          }

          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          // Ekspor data URL JPEG terkompresi (~20-40 KB)
          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.8);
          previewImg.src = compressedDataUrl;

          // Jika webhook Google Apps Script aktif, langsung upload ke Google Drive
          if (webhookUrl) {
            showToast('Sedang mengunggah foto ke Google Drive... Tombol simpan dinonaktifkan sementara.', 'info');
            try {
              const base64Data = compressedDataUrl.split(',')[1];
              const response = await fetch(webhookUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify({
                  type: 'UPLOAD_IMAGE',
                  fileName: 'produk_' + Date.now() + '.jpg',
                  mimeType: 'image/jpeg',
                  base64Data: base64Data
                })
              });

              const result = await response.json();
              if (result && result.status === 'success' && result.fileUrl) {
                tempProductImage = result.fileUrl; // Menyimpan link URL Google Drive
                previewImg.src = result.fileUrl;
                setProductSaveButtonLoading(false, '<span class="text-emerald-400 font-semibold">✅ Foto berhasil diupload ke Google Drive!</span>');
                showToast('✅ Foto barang tersimpan di Google Drive! Tombol simpan kini aktif.', 'success');
              } else {
                throw new Error(result.message || 'Gagal menerima URL file dari Drive');
              }
            } catch (err) {
              console.warn('Gagal upload ke Drive, memakai fallback lokal kompresi:', err);
              tempProductImage = compressedDataUrl;
              setProductSaveButtonLoading(false, '<span class="text-amber-400 font-semibold">⚠️ Foto disimpan lokal (Webhook offline)</span>');
              showToast('Webhook Drive belum merespon. Foto disimpan lokal (terkompresi).', 'info');
            }
          } else {
            tempProductImage = compressedDataUrl;
            setProductSaveButtonLoading(false, '<span class="text-amber-400">⚠️ Webhook Drive belum diatur (Tersimpan lokal)</span>');
            showToast('Foto dikompresi. Atur Webhook di Integrasi untuk upload langsung ke Google Drive.', 'info');
          }
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

