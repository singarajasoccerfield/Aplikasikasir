        if (!file) return;
        const reader = new FileReader();
        reader.onload = async (evt) => {
          try {
            const parsed = JSON.parse(evt.target.result);
            const d = parsed.data || parsed;
            if (Array.isArray(d.deletedIds)) d.deletedIds.forEach(id => markRecordDeleted(id));
            if (Array.isArray(d.products)) products = mergeUniqueById(products, d.products, 'id');
            if (Array.isArray(d.transactions)) transactions = mergeUniqueById(transactions, d.transactions, 'id');
            if (Array.isArray(d.bons)) bons = mergeUniqueById(bons, d.bons, 'id');
            if (Array.isArray(d.bookings)) bookings = mergeUniqueById(bookings, d.bookings, 'bookingId');
            if (Array.isArray(d.expenses)) expenses = mergeUniqueById(expenses, d.expenses, 'id');
            if (Array.isArray(d.attendance)) attendance = mergeUniqueById(attendance, d.attendance, 'id');
            if (Array.isArray(d.employees)) employees = mergeUniqueById(employees, d.employees, 'id');
            if (Array.isArray(d.closings)) closings = mergeUniqueById(closings, d.closings, 'id');

            setStored(KEY_PRODUCTS, products);
            setStored(KEY_TRANSACTIONS, transactions);
            setStored(KEY_BONS, bons);
            setStored(KEY_BOOKINGS, bookings);
            setStored(KEY_EXPENSES, expenses);
            setStored(KEY_ATTENDANCE, attendance);
            setStored(KEY_EMPLOYEES, employees);
            setStored(KEY_CLOSINGS, closings);

            await window.immediateCloudSync();
            renderDashboard();
            renderAttendancePage();
            renderClosingDashboard(false);
            renderInventoryTable();
            updateDatabaseHealthMetrics();
            showToast('✅ Database berhasil dipulihkan (Restore) & disinkronkan ke Cloud!', 'success');
          } catch (err) {
            showToast('File JSON Backup tidak valid: ' + err.message, 'error');
          }
        };
        reader.readAsText(file);
      };

      window.optimizeLocalDatabaseStorage = async function() {
        showToast('Mengoptimalkan database & mempartisi seluruh koleksi per tahun ke Cloud...', 'info');
        await window.immediateCloudSync();
        updateDatabaseHealthMetrics();
        showToast('✅ Optimasi selesai! Seluruh data telah terpartisi rapi per tahun dan aman untuk penggunaan jangka panjang.', 'success');
      };

      // =========================================================
      // H. AUTO-LOAD SAAT BUKA MENU & SAAT STARTUP APLIKASI
      // =========================================================
      const origSwitchTab = window.switchTab;
      window.switchTab = function(tabId) {
        if (typeof origSwitchTab === 'function') {
          origSwitchTab(tabId);
        }
        if (tabId === 'attendance') {
          window.fetchAttendanceFromDatabase(false);
        } else if (tabId === 'closing') {
          window.renderClosingDashboard(true);
        } else if (tabId === 'integration') {
          updateDatabaseHealthMetrics();
        }
      };

      window.addEventListener('DOMContentLoaded', () => {
        const closingDateEl = document.getElementById('closingDateInput');
        if (closingDateEl && !closingDateEl.value) {
          closingDateEl.value = getLocalDateString(new Date());
        }
        updateDatabaseHealthMetrics();

        // Tarik otomatis partisi database setelah inisialisasi
        setTimeout(() => {
          window.pullAllMultiYearPartitions(false);
        }, 1500);
      });
    })();
  </script>
</body>
</html>
