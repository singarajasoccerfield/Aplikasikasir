  <!-- ===================================================================================== -->
  <!-- 6. ENGINE DATABASE MULTI-TAHUN (INDEXED-DB + FIRESTORE SHARDING + RTDB + AUTO-BACKUP) -->
  <!-- ===================================================================================== -->
  <script>
    (function() {
      const RTDB_BASE_URL = (typeof OFFICIAL_FIREBASE_CONFIG !== 'undefined' && OFFICIAL_FIREBASE_CONFIG.dbUrl)
        ? OFFICIAL_FIREBASE_CONFIG.dbUrl.replace(/\/$/, '')
        : "https://singarajasoccerfield-1f2bb-default-rtdb.firebaseio.com";

      // =========================================================
      // A. INDEXED-DB ENGINE (KAPASITAS RATUSAN MB DI BROWSER)
      // Mengatasi batas 5MB LocalStorage agar awet bertahun-tahun
      // =========================================================
      const IDB_NAME = 'SingarajaSoccerfield_LongTermDB';
      const IDB_VERSION = 1;
      const IDB_STORE = 'collections_store';
      let idbInstance = null;

      function openIndexedDB() {
        return new Promise((resolve) => {
          if (!('indexedDB' in window)) return resolve(null);
          if (idbInstance) return resolve(idbInstance);
          try {
            const req = indexedDB.open(IDB_NAME, IDB_VERSION);
            req.onupgradeneeded = (e) => {
              const db = e.target.result;
              if (!db.objectStoreNames.contains(IDB_STORE)) {
                db.createObjectStore(IDB_STORE);
              }
            };
            req.onsuccess = (e) => {
              idbInstance = e.target.result;
              resolve(idbInstance);
            };
            req.onerror = () => resolve(null);
          } catch (err) {
            resolve(null);
          }
        });
      }

      async function idbSet(key, val) {
        const db = await openIndexedDB();
        if (!db) return false;
        return new Promise((resolve) => {
          try {
            const tx = db.transaction(IDB_STORE, 'readwrite');
            tx.objectStore(IDB_STORE).put(val, key);
            tx.oncomplete = () => resolve(true);
            tx.onerror = () => resolve(false);
          } catch (e) {
            resolve(false);
          }
        });
      }

      async function idbGet(key) {
        const db = await openIndexedDB();
        if (!db) return null;
        return new Promise((resolve) => {
          try {
            const tx = db.transaction(IDB_STORE, 'readonly');
            const req = tx.objectStore(IDB_STORE).get(key);
            req.onsuccess = () => resolve(req.result !== undefined ? req.result : null);
            req.onerror = () => resolve(null);
          } catch (e) {
            resolve(null);
          }
        });
      }

      // =========================================================
      // B. SAFE LOCALSTORAGE PENYIMPANAN CERDAS (ANTI QUOTA FULL)
      // Menyimpan penuh di IndexedDB & memangkas arsip sangat lama
      // di LocalStorage jika mendekati batas 5MB browser
      // =========================================================
      window.setStored = function(key, value) {
        // 1. Simpan 100% riwayat utuh tanpa batas ke IndexedDB
        idbSet(key, value);

        // 2. Simpan ke LocalStorage dengan pengaman otomatis jika kuota penuh
        try {
          localStorage.setItem(key, JSON.stringify(value));
        } catch (quotaErr) {
          console.warn('LocalStorage mendekati batas 5MB, mengaktifkan kompresi arsip lokal (data penuh tetap aman di IndexedDB & Cloud):', quotaErr);
          try {
            if (Array.isArray(value) && value.length > 500) {
              // Simpan 500 data terbaru di LocalStorage cepat, sisanya di IndexedDB & Cloud
              const recentSlice = value.slice(-500);
              localStorage.setItem(key, JSON.stringify(recentSlice));
            }
          } catch (e2) {}
        }

        updateDatabaseHealthMetrics();
        triggerAutoCloudSync(key, value);
      };

      // =========================================================
      // C. PARTISI DATABASE PER TAHUN (SHARDING BEBAS LIMIT 1 MB)
      // Setiap koleksi dipecah berdasarkan tahun (contoh: 2026, 2027, 2028)
      // sehingga dokumen Firestore tidak akan pernah penuh selamanya
      // =========================================================
      function extractYearFromItem(item) {
        const rawDate = item?.date || item?.timestamp || item?.createdAt || '';
        const match = String(rawDate).match(/^(\d{4})/);
        return match ? match[1] : String(new Date().getFullYear());
      }

      function groupArrayByYear(arr) {
        const groups = {};
        if (!Array.isArray(arr)) return groups;
        arr.forEach(item => {
          if (!item) return;
          const yr = extractYearFromItem(item);
          if (!groups[yr]) groups[yr] = [];
          groups[yr].push(item);
        });
        return groups;
      }

      // Simpan koleksi ke Cloud secara terpartisi per Tahun + RTDB + Master Index
      async function savePartitionedCollectionToCloud(collectionName, fullArray, idField = 'id') {
        const cleaned = cleanDatasetArray(fullArray, idField);
        await idbSet('ssf_full_' + collectionName, cleaned);
        updateCloudSyncStatus('SYNCING', 'Menyimpan Database...');
        let anySuccess = false;

        const yearGroups = groupArrayByYear(cleaned);
        const yearsList = Object.keys(yearGroups);
        if (yearsList.length === 0) {
          yearsList.push(String(new Date().getFullYear()));
          yearGroups[yearsList[0]] = [];
        }

        // 1. Simpan ke Cloud Firestore (Dokumen terpisah per Koleksi & per Tahun)
        if (window.FB_SDK && fbDb) {
          try {
            if (fbAuth && !fbAuth.currentUser) {
              await window.FB_SDK.signInAnonymously(fbAuth);
            }

            // Simpan indeks daftar tahun aktif + data terbaru di dokumen koleksi khusus
            const indexRef = window.FB_SDK.doc(fbDb, 'cloud_sync', 'ssf_' + collectionName);
            await window.FB_SDK.setDoc(indexRef, {
              updatedAt: new Date().toISOString(),
              availableYears: yearsList,
              deletedIds: (deletedIds || []).slice(-1000),
              items: cleaned.slice(-800) // 800 entri terbaru untuk muat cepat
            }, { merge: true });

            // Simpan setiap partisi tahun di dokumennya masing-masing (misal: ssf_attendance_2026, ssf_attendance_2027)
            for (const yr of yearsList) {
              const partRef = window.FB_SDK.doc(fbDb, 'cloud_sync', `ssf_${collectionName}_${yr}`);
              await window.FB_SDK.setDoc(partRef, {
                year: yr,
                collection: collectionName,
                updatedAt: new Date().toISOString(),
                items: yearGroups[yr] || []
              }, { merge: true });
            }
            anySuccess = true;
          } catch (err) {
            console.warn(`Firestore partitioned save warning (${collectionName}):`, err);
          }
        }

        // 2. Simpan ke Firebase Realtime Database (REST JSON terpartisi per tahun - Tanpa Batas 1MB Dokumen)
        try {
          await fetch(`${RTDB_BASE_URL}/ssf_v2/${collectionName}/meta.json`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              updatedAt: new Date().toISOString(),
              availableYears: yearsList,
              deletedIds: (deletedIds || []).slice(-1000)
            })
          });

          for (const yr of yearsList) {
            const res = await fetch(`${RTDB_BASE_URL}/ssf_v2/${collectionName}/years/${yr}.json`, {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(yearGroups[yr] || [])
            });
            if (res.ok) anySuccess = true;
          }
        } catch (err) {
          console.warn(`RTDB partitioned save warning (${collectionName}):`, err);
        }

        updateCloudSyncStatus(anySuccess ? 'ONLINE' : 'ERROR', anySuccess ? 'Cloud Sinkron' : 'Tersimpan Lokal');
        updateDatabaseHealthMetrics();
        return anySuccess;
      }

      // Ambil & Gabungkan Koleksi dari IndexedDB + Semua Partisi Tahun di Cloud Firestore + RTDB
      async function loadPartitionedCollectionFromCloud(collectionName, currentArray, idField = 'id', pullAllYears = true) {
        let combined = Array.isArray(currentArray) ? [...currentArray] : [];

        // 1. Cek cadangan penuh di IndexedDB lokal terlebih dahulu
        const idbCached = await idbGet('ssf_full_' + collectionName);
        if (Array.isArray(idbCached) && idbCached.length > 0) {
          combined = mergeUniqueById(combined, idbCached, idField);
        }

        const currentYear = String(new Date().getFullYear());
        let yearsToFetch = new Set([currentYear, String(Number(currentYear) - 1)]);

        // 2. Ambil dari Cloud Firestore (Dokumen Indeks + Partisi Tahun + Dokumen Legacy)
        if (window.FB_SDK && fbDb) {
          try {
            if (fbAuth && !fbAuth.currentUser) {
              await window.FB_SDK.signInAnonymously(fbAuth);
            }

            const indexRef = window.FB_SDK.doc(fbDb, 'cloud_sync', 'ssf_' + collectionName);
            const indexSnap = await window.FB_SDK.getDoc(indexRef);
            if (indexSnap.exists()) {
              const idxData = indexSnap.data();
              if (Array.isArray(idxData.deletedIds)) idxData.deletedIds.forEach(id => markRecordDeleted(id));
              if (Array.isArray(idxData.items)) {
                combined = mergeUniqueById(combined, idxData.items, idField);
              }
              if (pullAllYears && Array.isArray(idxData.availableYears)) {
                idxData.availableYears.forEach(y => yearsToFetch.add(String(y)));
              }
            }

            // Ambil setiap dokumen partisi tahunan
            for (const yr of yearsToFetch) {
              try {
                const partRef = window.FB_SDK.doc(fbDb, 'cloud_sync', `ssf_${collectionName}_${yr}`);
                const partSnap = await window.FB_SDK.getDoc(partRef);
                if (partSnap.exists()) {
                  const pData = partSnap.data();
                  if (Array.isArray(pData.items)) {
                    combined = mergeUniqueById(combined, pData.items, idField);
                  }
                }
              } catch (ePart) {}
            }

            // Ambil juga dari dokumen utama legacy (singaraja_soccerfield_data) agar data lama tidak hilang
            const mainRef = window.FB_SDK.doc(fbDb, 'cloud_sync', 'singaraja_soccerfield_data');
            const mainSnap = await window.FB_SDK.getDoc(mainRef);
            if (mainSnap.exists()) {
              const mData = mainSnap.data();
              if (Array.isArray(mData.deletedIds)) mData.deletedIds.forEach(id => markRecordDeleted(id));
              if (Array.isArray(mData[collectionName])) {
                combined = mergeUniqueById(combined, mData[collectionName], idField);
              }
            }
          } catch (err) {
            console.warn(`Firestore partitioned load warning (${collectionName}):`, err);
          }
        }

        // 3. Ambil dari Firebase Realtime Database (REST JSON)
        try {
          const metaRes = await fetch(`${RTDB_BASE_URL}/ssf_v2/${collectionName}/meta.json`);
          if (metaRes.ok) {
            const metaData = await metaRes.json();
            if (metaData) {
              if (Array.isArray(metaData.deletedIds)) metaData.deletedIds.forEach(id => markRecordDeleted(id));
              if (pullAllYears && Array.isArray(metaData.availableYears)) {
                metaData.availableYears.forEach(y => yearsToFetch.add(String(y)));
              }
            }
          }

          for (const yr of yearsToFetch) {
            const yrRes = await fetch(`${RTDB_BASE_URL}/ssf_v2/${collectionName}/years/${yr}.json`);
            if (yrRes.ok) {
              const yrItems = await yrRes.json();
              if (Array.isArray(yrItems)) {
                combined = mergeUniqueById(combined, yrItems, idField);
              }
            }
          }
        } catch (err) {
          console.warn(`RTDB partitioned load warning (${collectionName}):`, err);
        }

        const finalClean = cleanDatasetArray(combined, idField);
        await idbSet('ssf_full_' + collectionName, finalClean);
        return finalClean;
      }

