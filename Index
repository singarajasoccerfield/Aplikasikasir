    function renderCharts() {
      try {
        const trendCanvas = document.getElementById('salesTrendChart');
        const methodCanvas = document.getElementById('paymentMethodChart');

        if (!trendCanvas || !methodCanvas) return;

        // Pastikan pustaka Chart.js tersedia
        if (typeof Chart === 'undefined') {
          console.warn('Pustaka Chart.js belum selesai dimuat.');
          return;
        }

        // Siapkan data 7 hari terakhir secara akurat dengan tanggal lokal
        const labels = [];
        const dataValues = [];
        for (let i = 6; i >= 0; i--) {
          const d = new Date();
          d.setDate(d.getDate() - i);
          const dStr = getLocalDateString(d);
          labels.push(d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric' }));

          const sumTrx = (transactions || [])
            .filter(t => getLocalDateString(t.date) === dStr)
            .reduce((acc, t) => acc + Number(t.total || 0), 0);

          const sumBkg = (bookings || [])
            .filter(b => getLocalDateString(b.date) === dStr)
            .reduce((acc, b) => acc + Number(b.downPayment || 0), 0);

          dataValues.push(sumTrx + sumBkg);
        }

        // 1. Line Chart: Tren Penjualan 7 Hari
        if (trendChart) {
          try { trendChart.destroy(); } catch (e) {}
          trendChart = null;
        }

        const trendCtx = trendCanvas.getContext('2d');
        trendChart = new Chart(trendCtx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: 'Omset (Rp)',
              data: dataValues,
              borderColor: '#10b981',
              backgroundColor: 'rgba(16, 185, 129, 0.15)',
              tension: 0.35,
              fill: true,
              borderWidth: 2.5,
              pointBackgroundColor: '#10b981',
              pointBorderColor: '#ffffff',
              pointBorderWidth: 1.5,
              pointRadius: 4,
              pointHoverRadius: 6
            }]
